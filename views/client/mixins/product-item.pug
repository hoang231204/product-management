mixin product-item(item)
  .product-item
    .inner-image
      a(href=`/products/details/${item.slug}`)
        img(src=item.thumbnail, alt=item.title, width="300", height="300", loading="lazy", decoding="async")
      if(item.featured == "1")
        .inner-featured Nổi bật
      if(item.discountPercentage && item.discountPercentage > 0)
        .inner-discount -#{item.discountPercentage}%
    
    .p-3.d-flex.flex-column.flex-grow-1
      h3.inner-title.mb-2
        a(href=`/products/details/${item.slug}`) #{item.title}
      
      .mt-auto.pt-2.d-flex.align-items-baseline.gap-2.flex-wrap
        .inner-price-new #{item.priceNew ? item.priceNew.toLocaleString('vi-VN') : item.price} VND
        if(item.discountPercentage && item.discountPercentage > 0 && item.price)
          .inner-price-old #{item.price.toLocaleString('vi-VN')} VND
        else
          .inner-price-old Chưa có mã giảm giá

mixin blog-item(item)
  .blog-item
    .inner-image
      a(href=`/blogs/details/${item.slug}`)
        img(src=item.thumbnail, alt=item.title, width="400", height="300", loading="lazy", decoding="async")
    
    .p-3.d-flex.flex-column.flex-grow-1
      h3.inner-title.mb-2
        a(href=`/blogs/details/${item.slug}`) #{item.title}
      if(item.description)
        .inner-description #{item.description}
      .mt-auto.pt-2.d-flex.justify-content-between.align-items-center.small.text-muted
        if(item.createdAt)
          span.inner-date
            i.fa-regular.fa-calendar.me-1
            | #{moment ? moment(item.createdAt).format('DD/MM/YYYY') : item.createdAt}
        span.inner-author
          i.fa-regular.fa-user.me-1
          | #{item.author ? item.author : 'Admin'}