mixin boxSearch(keyword)
    form(id="form-search" class="w-100" action="/search" method="GET")
        .input-group
            input(
                type="text"
                placeholder="Tìm kiếm sản phẩm..."
                name="keyword"
                class="form-control"
                value=keyword
                aria-label="Tìm kiếm sản phẩm"
            )
            .input-group-append
                button(class="btn btn-primary" type="submit" aria-label="Tìm kiếm")
                    i.fa-solid.fa-magnifying-glass
