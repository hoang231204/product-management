extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .product-detail
    .container.my-4
      .product-detail-card.p-4.bg-white.rounded-lg.shadow-sm
        .row.g-4.align-items-center
          // Left Product Image
          .col-lg-6
            .inner-thumb.text-center.p-3.border.rounded-lg.bg-light
              img(src=product.thumbnail, alt=product.title class="img-fluid rounded object-fit-cover" style="max-height: 420px; width: 100%;")

          // Right Product Info & Actions
          .col-lg-6
            .ps-lg-3
              h1.inner-title.fw-bold.mb-3 #{product.title}

              if (product.category)
                div.inner-category.mb-3
                  span.text-muted.me-2 Danh mục: 
                  a(href=`/products/${product.category.slug}` class="badge badge-primary px-3 py-2") #{product.category.title}
              
              .d-flex.align-items-baseline.gap-3.mb-3
                if (product.priceNew)
                  div.inner-price-new.h2.fw-bold.text-primary.mb-0 #{product.priceNew.toLocaleString('vi-VN')} VND
                if (product.price && product.discountPercentage)
                  div.inner-price-old.h5.text-muted.text-decoration-line-through.mb-0 #{product.price.toLocaleString('vi-VN')} VND
                  div.inner-percent
                    span.badge.badge-danger.px-2.py-1 -#{product.discountPercentage}%

              if (product.stock)
                div.inner-stock.mb-4
                  i.fa-solid.fa-box.me-2.text-muted
                  | Tình trạng kho: <span class="fw-bold text-success">Còn #{product.stock} sản phẩm</span>
              else
                div.inner-stock.mb-4
                  i.fa-solid.fa-box.me-2.text-muted
                  | Tình trạng kho: <span class="fw-bold text-danger">Hết hàng</span>

              // Form Add to Cart
              .inner-action.bg-light.p-4.rounded-lg.border.mb-4
                form(action=`/carts/add/${product._id}` method="POST")
                  label.fw-bold.mb-2 Số lượng mua:
                  .d-flex.gap-3.align-items-center.mb-3
                    input(
                      class="form-control text-center font-weight-bold"
                      type="number"
                      name="quantity"
                      value="1"
                      min="1"
                      max=product.stock
                      style="max-width: 100px;"
                    )
                    button(type="submit" class="btn btn-primary btn-lg flex-grow-1 font-weight-bold shadow-sm")
                      i.fa-solid.fa-cart-plus.me-2
                      | Thêm vào giỏ hàng

              .inner-back
                a(href="/products" class="btn btn-outline-secondary")
                  i.fa-solid.fa-arrow-left.me-2
                  | Quay lại danh sách sản phẩm

        // Description Section
        .row.mt-5
          .col-12
            .inner-desc.p-4.border.rounded-lg.bg-white
              h4.inner-desc-title.fw-bold.mb-3
                i.fa-solid.fa-circle-info.me-2.text-primary
                | Mô tả sản phẩm
              .inner-desc-content !{product.description}