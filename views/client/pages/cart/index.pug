extends ../../layouts/default.pug
include ../../mixins/show-alert.pug
block main
  +alert-success(5000)
  +alert-error(5000)
  .container.my-4
    section.cart-hero
      .row.align-items-center
        .col-lg-8
          span.cart-hero__tag Giỏ hàng của bạn
          h1.cart-hero__title Chuẩn bị đơn hàng thật nhanh và dễ dàng 
          p.cart-hero__desc Chúng tôi đã chuẩn bị sẵn các sản phẩm bạn đã chọn, hãy kiểm tra lại giỏ hàng và tiến hành thanh toán để nhận được những ưu đãi tốt nhất từ chúng tôi.
        .col-lg-4.d-none.d-lg-flex.justify-content-end
          .cart-hero__icon
            i.fa-solid.fa-bag-shopping

  .container.mb-5
    if cartDetail && cartDetail.products.length > 0
      .row
        .col-lg-8.mb-4
          .cart-card
            .cart-card__header
              h2.cart-card__title Giỏ hàng của bạn
              span.cart-card__count #{cartDetail.products.length} sản phẩm

            .table-responsive
              table.table.cart-table.align-middle
                thead
                  tr
                    th STT
                    th Sản phẩm
                    th Đơn giá
                    th Số lượng
                    th Tồn kho
                    th Tổng cộng
                    th Hành động
                tbody
                  each item, index in cartDetail.products
                    tr
                      td.cart-table__index #{index + 1}
                      td
                        .cart-product
                          img(src=item.product_id.thumbnail, alt=item.product_id.title)
                          .cart-product__info
                            a(href=`/products/details/${item.product_id.slug}`) #{item.product_id.title}
                      td.cart-table__price #{(item.product_id.priceNew || 0).toLocaleString('vi-VN')} VND
                      td
                        .cart-qty-control
                          button.cart-qty-btn(type="button" cart-qty-action="decrease" aria-label="Giam so luong")
                            i.fa-solid.fa-minus
                          input.cart-qty-input(
                            type="number"
                            value=item.quantity
                            min="1"
                            max=item.product_id.stock
                            product-id=item.product_id._id
                            name="quantity"
                          )
                          button.cart-qty-btn(type="button" cart-qty-action="increase" aria-label="Tang so luong")
                            i.fa-solid.fa-plus
                      td.cart-table__stock #{item.product_id.stock}
                      td.cart-table__subtotal #{( (item.product_id.priceNew || 0) * item.quantity).toLocaleString('vi-VN')} VND
                      td.text-right
                        a.btn.btn-sm.btn-outline-danger(href=`/carts/delete/${item.product_id._id}`)
                          i.fa-solid.fa-trash-can.me-1
                          | Xóa

        .col-lg-4.mb-4
          .cart-summary
            h3.cart-summary__title Thông tin đơn hàng
            .cart-summary__row
              span Tạm tính
              strong #{cartDetail.totalPrice.toLocaleString('vi-VN')} VND
            .cart-summary__row
              span Phí giao hàng
              strong Miễn phí
            .cart-summary__row.cart-summary__row--total
              span Tổng cộng
              strong #{cartDetail.totalPrice.toLocaleString('vi-VN')} VND

            a.btn.btn-primary.btn-lg.btn-block.mt-3(href="/checkout")
              i.fa-solid.fa-credit-card.me-2
              | Tiến hành thanh toán
            a.btn.btn-outline-primary.btn-block.mt-2(href="/products")
              i.fa-solid.fa-arrow-left.me-2
              | Tiếp tục mua sắm
            a.btn.btn-secondary.btn-block.mt-2(href="/orders")
              i.fa-solid.fa-box-archive.me-2
              | Đơn hàng đã thanh toán

    else
      a.btn.btn-secondary.btn-block.mt-2(href="/orders")
              i.fa-solid.fa-box-archive.me-2
              | Đơn hàng đã mua
      .cart-empty
        .cart-empty__icon
          i.fa-solid.fa-basket-shopping
        h2.cart-empty__title Giỏ hàng của bạn đang trống
        p.cart-empty__desc Hãy thêm những sản phẩm yêu thích vào giỏ hàng của bạn để tiếp tục mua sắm.
        a.btn.btn-primary.btn-lg(href="/products")
          i.fa-solid.fa-seedling.me-2
          | Quay lại mua sắm