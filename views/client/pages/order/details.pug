extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.my-4
    +boxhead("Chi tiết đơn hàng")
    .card.p-4.border-0.shadow-sm.rounded-lg
      
      //- Phần thông tin chung & Trạng thái đơn hàng
      .d-flex.align-items-center.justify-content-between.mb-4.pb-3.border-bottom.flex-wrap
        div
          h3.fw-bold.mb-1 Mã đơn: #{order.order_code ? order.order_code : order._id}
          p.text-muted.mb-0 Ngày đặt hàng: #{moment(order.createdAt).format("DD/MM/YYYY HH:mm")}
        
        .d-flex.align-items-center.gap-2
          span.fw-bold.me-2 Trạng thái:
          if order.status == 'pending'
            span.badge.badge-warning.px-3.py-2 Đang chờ xử lý
          else if order.status == 'confirmed'
            span.badge.badge-info.px-3.py-2 Đã xác nhận
          else if order.status == 'shipped' || order.status == 'shipping'
            span.badge.badge-primary.px-3.py-2 Đang giao hàng
          else if order.status == 'delivered'
            span.badge.badge-success.px-3.py-2 Đã giao thành công
          else
            span.badge.badge-danger.px-3.py-2 Đã hủy

      //- Thông tin người nhận (Customer Info Card)
      .card.bg-light.p-3.mb-4.border-0
        h5.fw-bold.mb-3
          i.fa-solid.fa-user.me-2.text-primary
          | Thông tin người nhận
        .row.g-3
          .col-md-4
            .text-muted.small Họ tên:
            .fw-bold #{order.userInfor ? order.userInfor.fullname : '--'}
          .col-md-4
            .text-muted.small Số điện thoại:
            .fw-bold #{order.userInfor ? order.userInfor.phone : '--'}
          .col-md-4
            .text-muted.small Địa chỉ giao hàng:
            .fw-bold #{order.userInfor ? order.userInfor.address : '--'}

      //- Danh sách sản phẩm trong đơn hàng
      h5.fw-bold.mb-3
        i.fa-solid.fa-box-archive.me-2.text-primary
        | Danh sách sản phẩm

      if order && order.products && order.products.length > 0
        .table-responsive
          table.table.table-hover.align-middle
            thead.table-light
              tr.text-center
                th(width="50px") STT
                th(width="80px") Ảnh
                th.text-start Sản phẩm
                th Đơn giá
                th Số lượng
                th Thành tiền
                th Action
            tbody
              each item, index in order.products
                if item.product_id
                  tr.text-center
                    td.fw-bold= index + 1
                    td
                      img.rounded.object-fit-cover(src=item.product_id.thumbnail, alt=item.product_id.title, width="60", height="60")
                    td.text-start.fw-bold= item.product_id.title
                    td #{item.priceNew ? item.priceNew.toLocaleString('vi-VN') : 0} VND
                    td.fw-bold= item.quantity
                    td.text-success.fw-bold #{((item.priceNew || 0) * item.quantity).toLocaleString('vi-VN')} VND
                    td
                      a.btn.btn-sm.btn-outline-primary(href=`/products/details/${item.product_id.slug}`) Mua lại
                else
                  tr
                    td(colspan="7" class="text-muted text-center py-3") Sản phẩm này đã ngừng kinh doanh

        .d-flex.justify-content-between.align-items-center.mt-4.pt-3.border-top.flex-wrap
          a.btn.btn-outline-secondary(href="/products")
            i.fa-solid.fa-arrow-left.me-2
            | Tiếp tục mua sắm
          .h3.fw-bold.mb-0.text-primary
            span.text-muted.fs-6.me-2 Tổng cộng:
            | #{order.totalPrice ? order.totalPrice.toLocaleString('vi-VN') : 0} VND
      else
        p.text-center.text-muted.py-4 Không tìm thấy chi tiết sản phẩm.