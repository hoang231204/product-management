extends ../../layouts/default.pug
include ../../mixins/show-alert.pug
include ../../mixins/box-head.pug

block main
  .container.my-4
    +alert-success(3000)
    +alert-error(3000)

    +boxhead("Danh sách đơn hàng")

    .card.mb-3.shadow-sm
      .card-header.font-weight-bold.bg-white.py-3 
        | Danh sách đơn hàng
      .card-body
        .table-responsive
          table.table.table-hover.table-sm.align-middle
            thead.thead-light
              tr
                th STT
                th Họ tên
                th Số điện thoại
                th Địa chỉ
                th Tổng tiền
                th Trạng thái
                th.text-center Hành động
            tbody
              if orders && orders.length > 0
                each item, index in orders
                  tr
                    td.align-middle= index + 1
                    td.align-middle.font-weight-bold= item.fullname
                    td.align-middle= item.phone
                    td.align-middle= item.address
                    td.align-middle.text-danger.font-weight-bold #{item.totalPrice.toLocaleString()} VND
                    td.align-middle
                      if item.status == 'pending'
                        span.badge.badge-warning Đang chờ
                      else if item.status == 'confirmed'
                        span.badge.badge-info Đã xác nhận
                      else if item.status == 'shipped'
                        span.badge.badge-primary Đang giao
                      else if item.status == 'delivered'
                        span.badge.badge-success Đã giao
                      else
                        span.badge.badge-danger Đã hủy
                    td.align-middle.text-center
                      a.btn.btn-info.btn-sm.text-white.mb-1(href=`/orders/details/${item._id}`) Chi tiết
                      a.btn.btn-secondary.btn-sm.mb-1.ml-1(href=`/orders/edit/${item._id}`) Sửa thông tin
                      button.btn.btn-danger.btn-sm.mb-1.ml-1(type="button" data-id=item._id button-cancel) Hủy đơn
              else
                tr
                  td(colspan="7" class="text-center py-4 text-muted") 
                    | Không có đơn hàng nào!  

    //- Form ẩn phục vụ cho việc gửi request hủy đơn hàng qua JavaScript
    form(
      action=""
      method="POST"
      form-cancel
      data-path="/orders/cancel"
      style="display: none;"
    )