extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.my-4
    section.contact-hero
      .contact-hero__shape.contact-hero__shape--one
      .contact-hero__shape.contact-hero__shape--two
      .row.align-items-center
        .col-lg-7
          span.contact-hero__tag Liên hệ nhanh
          h1.contact-hero__title Chúng tôi luôn sẵn sàng hỗ trợ bạn
          p.contact-hero__desc Hãy liên hệ với chúng tôi qua điện thoại, email hoặc đến trực tiếp cửa hàng để được tư vấn và hỗ trợ nhanh chóng.
          .contact-hero__meta
            span
              i.fa-solid.fa-clock.me-1
              | Hỗ trợ 08:00 - 22:00 mỗi ngày
            span
              i.fa-solid.fa-phone-volume.me-1
              | Hotline: #{websiteInfor && websiteInfor.phone ? websiteInfor.phone : "0901 234 567"}
        .col-lg-5.d-none.d-lg-flex.justify-content-center
          .contact-hero__visual
            i.fa-solid.fa-envelope-open-text

  .container.my-5
    .box-head
      +boxhead("Thông tin liên hệ")

    .row
      .col-lg-4.mb-4
        .contact-card.h-100
          .contact-card__icon
            i.fa-solid.fa-location-dot
          h3.contact-card__title Địa chỉ của cửa hàng
          p.mb-2 #{websiteInfor && websiteInfor.address ? websiteInfor.address : "123 Nguyen Hue, Quan 1, TP. Ho Chi Minh"}
          p.text-muted.mb-0 Nhắn tin trực tiếp hoặc đến cửa hàng để xem và chọn hoa.

      .col-lg-4.mb-4
        .contact-card.h-100
          .contact-card__icon
            i.fa-solid.fa-phone
          h3.contact-card__title Hotline đặt hoa
          p.mb-2 #{websiteInfor && websiteInfor.phone ? websiteInfor.phone : "0901 234 567"}
          p.text-muted.mb-0 Hỗ trợ đặt hoa gấp, tư vấn mẫu hoa theo sự kiện.

      .col-lg-4.mb-4
        .contact-card.h-100
          .contact-card__icon
            i.fa-solid.fa-envelope
          h3.contact-card__title Email hỗ trợ
          p.mb-2 #{websiteInfor && websiteInfor.email ? websiteInfor.email : "support@freshbloom.vn"}
          p.text-muted.mb-0 Gửi yêu cầu hỗ trợ, phản hồi hoặc hợp tác kinh doanh qua email.

  .container.mb-5
    .row
      .col-lg-7.mb-4
        .contact-form-card
          h2.contact-form-card__title Gửi thông tin liên hệ
          p.text-muted.mb-4 Vui lòng điền đầy đủ thông tin, chúng tôi sẽ phản hồi trong vòng 30 phút.

          form(action="/contact" method="POST")
            .form-group
              label(for="fullname") Họ và tên
              input#fullname.form-control(type="text" name="fullName" placeholder="Nhập họ và tên" required)

            .form-group
              label(for="phone") Số điện thoại
              input#phone.form-control(type="text" name="phone" placeholder="Nhập số điện thoại" required)

            .form-group
              label(for="email") Email
              input#email.form-control(type="email" name="email" placeholder="Nhập địa chỉ email")

            .form-group
              label(for="message") Nội dung cần hỗ trợ
              textarea#message.form-control(name="message" rows="5" placeholder="Mô tả yêu cầu của bạn..." required)

            .contact-form-card__footer
              small.text-muted Chúng tôi cam kết bảo mật thông tin của bạn và sẽ không chia sẻ cho bên thứ ba.
              button.btn.btn-primary.btn-lg(type="submit")
                i.fa-solid.fa-paper-plane.me-2
                | Gửi yêu cầu

      .col-lg-5.mb-4
        .contact-form-card.h-100
          h2.contact-form-card__title Bản đồ cửa hàng
          p.text-muted.mb-3 Bạn có thể đến cửa hàng để xem và chọn hoa trực tiếp.
          .contact-map
            if (websiteInfor && websiteInfor.mapLocation)
              //- Sử dụng cú pháp !{} để render mã iframe HTML lưu trong database
              | !{websiteInfor.mapLocation}
            else
              iframe(src="https://www.google.com/maps?q=10.7769,106.7009&z=15&output=embed" width="100%" height="100%" style="border:0;" loading="lazy" referrerpolicy="no-referrer-when-downgrade")

  style.
    @keyframes riseFade {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes floatSlow {
      0%, 100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-8px);
      }
    }

    .contact-hero {
      position: relative;
      overflow: hidden;
      padding: clamp(1.75rem, 3.5vw, 2.75rem);
      border-radius: var(--md-radius-lg);
      border: 1px solid rgba(255, 255, 255, 0.28);
      background:
        radial-gradient(circle at 88% 15%, rgba(255, 255, 255, 0.26) 0, transparent 32%),
        linear-gradient(135deg, #d85b86 0%, #f28db3 55%, #f9b7cb 100%);
      box-shadow: 0 18px 36px rgba(173, 56, 106, 0.2);
      color: #fff8fb;
      animation: riseFade 520ms ease-out;
    }

    .contact-hero__shape {
      position: absolute;
      border-radius: 9999px;
      pointer-events: none;
      filter: blur(2px);
      opacity: 0.8;
    }

    .contact-hero__shape--one {
      width: 180px;
      height: 180px;
      right: -36px;
      top: -50px;
      background: rgba(255, 255, 255, 0.2);
      animation: floatSlow 5s ease-in-out infinite;
    }

    .contact-hero__shape--two {
      width: 140px;
      height: 140px;
      left: -34px;
      bottom: -40px;
      background: rgba(255, 231, 242, 0.35);
      animation: floatSlow 6s ease-in-out infinite;
    }

    .contact-hero__tag {
      display: inline-flex;
      align-items: center;
      margin-bottom: 0.9rem;
      padding: 0.4rem 0.85rem;
      border-radius: var(--md-radius-pill);
      background: rgba(255, 255, 255, 0.9);
      color: #a63a66;
      font-size: 0.82rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .contact-hero__title {
      margin-bottom: 0.75rem;
      font-size: clamp(1.8rem, 3vw, 2.5rem);
      line-height: 1.2;
      color: #fff9fc;
      font-weight: 700;
    }

    .contact-hero__desc {
      margin-bottom: 1.2rem;
      color: rgba(255, 250, 252, 0.92);
    }

    .contact-hero__meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .contact-hero__meta span {
      display: inline-flex;
      align-items: center;
      padding: 0.35rem 0.75rem;
      border-radius: var(--md-radius-pill);
      border: 1px solid rgba(255, 255, 255, 0.32);
      background: rgba(255, 255, 255, 0.18);
      font-size: 0.9rem;
    }

    .contact-hero__visual {
      width: 210px;
      height: 210px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255, 255, 255, 0.2);
      border: 1px solid rgba(255, 255, 255, 0.4);
      animation: floatSlow 4.8s ease-in-out infinite;
    }

    .contact-hero__visual i {
      margin: 0;
      font-size: 5.5rem;
      color: #fff8fb;
    }

    .contact-card,
    .contact-form-card {
      border: 1px solid rgba(216, 91, 134, 0.16);
      border-radius: var(--md-radius-md);
      background: var(--md-surface);
      box-shadow: var(--shadow-sm);
      padding: 1.25rem;
      height: 100%;
      transition: transform var(--md-transition), box-shadow var(--md-transition), border-color var(--md-transition);
      animation: riseFade 520ms ease-out;
    }

    .contact-card:hover,
    .contact-form-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-md);
      border-color: rgba(216, 91, 134, 0.28);
    }

    .contact-card__icon {
      width: 2.9rem;
      height: 2.9rem;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--md-primary-container);
      color: var(--md-primary);
      margin-bottom: 0.85rem;
    }

    .contact-card__icon i {
      margin: 0;
      font-size: 1.1rem;
    }

    .contact-card__title,
    .contact-form-card__title {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--md-on-background);
      margin-bottom: 0.55rem;
    }

    .contact-form-card .form-control {
      background: var(--md-surface-container-low);
      border: 1px solid rgba(216, 91, 134, 0.2);
    }

    .contact-form-card .form-control:focus {
      border-color: var(--md-primary);
      box-shadow: 0 0 0 0.2rem rgba(216, 91, 134, 0.16);
      background: #fff;
    }

    .contact-form-card__footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.9rem;
      flex-wrap: wrap;
      margin-top: 0.35rem;
    }

    .contact-form-card .btn-primary {
      min-width: 170px;
      font-weight: 700;
      letter-spacing: 0.01em;
    }

    .contact-form-card .btn-primary:hover {
      transform: translateY(-1px) scale(1.01);
    }

    .contact-map {
      width: 100%;
      height: 320px;
      border-radius: var(--md-radius-sm);
      overflow: hidden;
      border: 1px solid rgba(216, 91, 134, 0.18);
      background: var(--md-surface-container-low);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.6);
    }

    @media (max-width: 991.98px) {
      .contact-hero {
        padding: 1.35rem;
      }

      .contact-form-card__footer {
        align-items: stretch;
      }

      .contact-form-card .btn-primary {
        width: 100%;
      }

      .contact-map {
        height: 280px;
      }
    }