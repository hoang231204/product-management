extends ../../layouts/default.pug
include ../../mixins/box-head.pug
include ../../mixins/show-alert.pug

block main
  +alert-success(5000)
  +alert-error(5000)
  .container.my-5
    +boxhead("Đặt hàng")

    if cartDetail && cartDetail.products.length > 0
      table(class="table table-bordered text-center align-middle")
        thead
          tr
            th STT
            th Ảnh
            th Tên
            th Giá
            th Số lượng
            th Tổng tiền
        tbody
          each item, index in cartDetail.products
            tr
              td #{index + 1}
              td
                img(src=item.product_id.thumbnail, alt=item.product_id.title, width="80px")
              td(class="text-start") #{item.product_id.title}
              td #{item.product_id.priceNew.toLocaleString('vi-VN')} VND
              td #{item.quantity}
              //- Đã sửa lỗi thiếu ngoặc đơn ở phép tính tổng tiền từng sản phẩm dưới đây
              td #{(item.product_id.priceNew * item.quantity).toLocaleString('vi-VN')} VND

      .row.mb-4
        .col-md-12.text-end
          h3 Tổng tiền: #{cartDetail.totalPrice.toLocaleString('vi-VN')} VND

      .row
        .col-md-8.offset-md-2
          div(class="card p-4 shadow-sm")
            //- Form chính (mặc định action trỏ về /checkout/cash hoặc bạn có thể bỏ action ở form)
            form(method="POST")
              div(class="mb-3")
                label(for="fullname" class="form-label fw-bold") Họ tên
                input(
                  type="text"
                  id="fullname"
                  name="fullname"
                  class="form-control"
                  placeholder="Nhập họ tên của bạn"
                  required
                )
              div(class="mb-3")
                label(for="phone" class="form-label fw-bold") Số điện thoại
                input(
                  type="text"
                  id="phone"
                  name="phone"
                  class="form-control"
                  placeholder="Nhập số điện thoại của bạn"
                  required
                )
              div(class="mb-4")
                label(for="address" class="form-label fw-bold") Địa chỉ
                input(
                  type="text"
                  id="address"
                  name="address"
                  class="form-control"
                  placeholder="Nhập địa chỉ của bạn"
                  required
                )
              
              //- Nhóm 2 button với 2 đường dẫn (route) xử lý riêng biệt
              .row
                .col-md-6.mb-2
                  button(
                    type="submit" 
                    formaction="/checkout/cash" 
                    class="btn btn-success w-100 btn-lg text-uppercase"
                  ) Thanh toán tiền mặt
                .col-md-6.mb-2
                  button(
                    type="submit" 
                    formaction="/checkout/vnpay" 
                    class="btn btn-primary w-100 btn-lg text-uppercase"
                  ) Thanh toán VNPAY

    else
      .text-center
        p(class="alert alert-warning") Giỏ hàng trống!
        a(href="/products" class="btn btn-primary") Quay lại mua sắm