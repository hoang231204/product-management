extends ../../layouts/default.pug

block main
  .container.my-5
    //- Thông báo thành công
    div(class="alert alert-success mb-4 shadow-sm border-0" role="alert")
      i.fa-solid.fa-circle-check.me-2
      | Chúc mừng bạn đã đặt hàng thành công! Chúng tôi sẽ xử lý đơn hàng trong thời gian sớm nhất.

    //- Thông tin cá nhân (Đã được thiết kế lại dạng Card hiện đại)
    h4(class="mb-3 fw-bold text-dark") 
      i.fa-solid.fa-user.me-2.text-primary
      | Thông tin cá nhân

    .card.border-0.shadow-sm.mb-5
      .card-body.p-4
        .row.mb-3.align-items-center
          .col-md-3.fw-bold.text-secondary
            i.fa-solid.fa-signature.me-2
            | Họ tên:
          .col-md-9.fs-6.fw-semibold.text-dark #{order.userInfor.fullname}
        hr.text-muted.opacity-10
        .row.mb-3.align-items-center
          .col-md-3.fw-bold.text-secondary
            i.fa-solid.fa-phone.me-2
            | Số điện thoại:
          .col-md-9.fs-6.fw-semibold.text-dark #{order.userInfor.phone}
        hr.text-muted.opacity-10
        .row.align-items-center
          .col-md-3.fw-bold.text-secondary
            i.fa-solid.fa-location-dot.me-2
            | Địa chỉ:
          .col-md-9.fs-6.fw-semibold.text-dark #{order.userInfor.address}

    //- Thông tin đơn hàng
    h4(class="mb-3 fw-bold text-dark") 
      i.fa-solid.fa-box-open.me-2.text-primary
      | Thông tin đơn hàng

    if order && order.products && order.products.length > 0
      .card.border-0.shadow-sm
        .card-body.p-0
          .table-responsive.mb-0
            table(class="table table-hover text-center align-middle mb-0")
              thead(class="table-light text-uppercase fs-7")
                tr
                  th.py-3 STT
                  th.py-3 Ảnh
                  th.py-3.text-start Tên sản phẩm
                  th.py-3 Giá
                  th.py-3 Số lượng
                  th.py-3 Tổng tiền
              tbody
                each item, index in order.products
                  tr
                    td.fw-bold #{index + 1}
                    td.py-3
                      if item.product_id
                        img(src=item.product_id.thumbnail, alt=item.product_id.title, width="60px", class="img-fluid rounded shadow-sm")
                      else
                        span.text-muted Không có ảnh
                    td(class="text-start")
                      if item.product_id
                        span.fw-semibold #{item.product_id.title}
                      else
                        span.text-danger Sản phẩm đã bị xóa hoặc ngừng kinh doanh
                    td 
                      if item.priceNew
                        span.fw-semibold #{item.priceNew.toLocaleString('vi-VN')} VND
                      else
                        | 0 VND
                    td 
                      span.badge.bg-light.text-dark.border.px-2.py-1 #{item.quantity}
                    td 
                      if item.priceNew
                        span.text-danger.fw-bold #{(item.priceNew * item.quantity).toLocaleString('vi-VN')} VND
                      else
                        | 0 VND

        .card-footer.bg-white.py-4.text-end.border-0
          h3.mb-0 Tổng đơn hàng: 
            span(class="fw-bold text-danger ms-2") #{order.totalPrice.toLocaleString('vi-VN')} VND

    else
      .text-center.py-5
        p(class="text-muted fs-5") Không có đơn hàng nào được tìm thấy.
    .text-center.mt-5
      a(href="/products" class="btn btn-primary px-4 py-2 me-2") 
        i.fa-solid.fa-arrow-left.me-2
        | Tiếp tục mua sắm
      a(href="/orders" class="btn btn-outline-primary px-4 py-2") 
        i.fa-solid.fa-box-archive.me-2
        | Xem đơn hàng của tôi