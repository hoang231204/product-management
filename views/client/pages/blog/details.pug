extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
    .blog-detail-page.my-4
        .container
            .blog-detail-shell
                .blog-detail-breadcrumb
                    a(href="/") Trang chủ
                    i.fa-solid.fa-angle-right
                    a(href="/blogs") Blog
                    i.fa-solid.fa-angle-right
                    span #{blog.title}

                h1.blog-detail-title #{blog.title}

                .blog-detail-meta
                    if (blog.category)
                        span.blog-meta-chip
                            i.fa-solid.fa-folder-open.me-1
                            | #{blog.category.title}
                    if (blog.createdAt)
                        span.blog-meta-chip
                            i.fa-regular.fa-calendar.me-1
                            | #{moment ? moment(blog.createdAt).format("DD/MM/YYYY") : blog.createdAt}
                    span.blog-meta-chip
                        i.fa-regular.fa-user.me-1
                        | #{blog.author ? blog.author : 'Admin'}

                if blog.thumbnail
                    .blog-detail-thumb
                        img(src=blog.thumbnail, alt=blog.title)

                .blog-detail-content !{blog.content}

                .blog-detail-footer
                    a(href="/blogs" class="btn btn-outline-primary")
                        i.fa-solid.fa-arrow-left.me-2
                        | Quay lại danh sách bài viết