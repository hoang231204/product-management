include ../mixins/sub-menu.pug
include ../mixins/search.pug
- const isHomeActive = currentPath === "/"
- const isProductActive = currentPath.startsWith("/products") || currentPath.startsWith("/search")
- const isBlogActive = currentPath.startsWith("/blogs")
- const isContactActive = currentPath.startsWith("/contact")
header.header
  .container
    .d-flex.align-items-center.justify-content-between.gap-3.flex-wrap
      // Brand Logo
      .inner-logo
        a(href="/")
          if websiteInfor && websiteInfor.logo
            img(src=websiteInfor.logo, alt="Logo SanPham", width="52", height="52")
          else
            img(src="/client/images/logo.png", alt="Logo SanPham", width="52", height="52")
      
      // Search Bar
      .inner-search.flex-grow-1(style="max-width: 380px;")
        +boxSearch(keyword)

      // Main Navigation Menu
      .inner-menu
        ul
          li(class=isHomeActive ? "active" : "")
            a(href="/") Trang chủ
          li(class=`sub-menu ${isProductActive ? 'active' : ''}`)
            -const path = `/products`
            a(href=path) Sản phẩm
              +subMenu(categoryTree,path)
          li(class=isBlogActive ? "active" : "")
            a(href="/blogs") Bài viết
          li(class=isContactActive ? "active" : "")
            a(href="/contact") Liên hệ

      // User Profile & Actions
      .inner-user
        if user
          .dropdown
            button#userDropdown.btn.btn-sm.btn-outline-primary.dropdown-toggle(type="button" data-toggle="dropdown" aria-expanded="false")
              i.fa-solid.fa-user.me-1
              | #{user.fullname}
            ul.dropdown-menu.dropdown-menu-end(aria-labelledby="userDropdown")
              li
                a.dropdown-item(href="/users/profile")
                  i.fa-solid.fa-id-card.me-2
                  | Xem hồ sơ
              li
                hr.dropdown-divider
              li
                a.dropdown-item.text-danger(href="/users/logout")
                  i.fa-solid.fa-right-from-bracket.me-2
                  | Đăng xuất
        else
          a(href="/users/login" class="btn btn-sm btn-primary")
            i.fa-solid.fa-user.me-1
            | Đăng nhập

      // Cart Badge Counter
      .inner-cart
        a(href="/carts" class="btn btn-sm btn-secondary position-relative")
          i.fa-solid.fa-bag-shopping.me-1
          | Giỏ hàng
          span(class="badge badge-pill badge-primary ms-1") #{miniCartCount ? miniCartCount : 0}