extends ../../layouts/default.pug
include ../../mixins/show-alert.pug

block main
    +alert-error(5000)
    +alert-success(5000)

    .container-fluid
        .d-flex.align-items-center.justify-content-between.mb-4
            div
                h3.fw-bold.mb-1.text-white Chi tiết tài khoản quản trị
                p.text-muted.mb-0 Xem thông tin chi tiết tài khoản quản trị viên hệ thống
            .d-flex.gap-2
                if role.permissions.includes("account_edit")
                    a(href=`${prefixAdmin}/accounts/edit/${account._id}` class="btn btn-warning") 
                        i.fa-solid.fa-pen-to-square.me-1
                        | Chỉnh sửa
                a(href=`${prefixAdmin}/accounts` class="btn btn-secondary") 
                    i.fa-solid.fa-arrow-left.me-1
                    | Quay lại danh sách

        .row.g-4
            // Left Profile & Avatar (4/12)
            .col-lg-4
                .card.text-center.p-4
                    img(
                        src=(account.avatar ? account.avatar : "/admin/images/avatar-default.png")
                        class="rounded-circle object-fit-cover border border-secondary mb-3 mx-auto"
                        width="140"
                        height="140"
                        alt=account.fullname
                    )
                    h4.fw-bold.text-white.mb-1 #{account.fullname}
                    span.badge.badge-primary.px-3.py-2.mb-3 #{account.role_id ? account.role_id.title : "Chưa phân quyền"}

                    .text-start.border-top.border-secondary.pt-3
                        div.mb-2 <b>Email:</b> #{account.email}
                        div.mb-2 <b>Số điện thoại:</b> #{account.phone || "Chưa cập nhật"}
                        div.mb-2 <b>Trạng thái:</b> 
                            if account.status === 'active'
                                span.badge.badge-success.ms-2 Hoạt động
                            else
                                span.badge.badge-danger.ms-2 Dừng hoạt động

            // Right Info & History (8/12)
            .col-lg-8
                .card.mb-4
                    .card-header.fw-bold Thông tin khởi tạo hệ thống
                    .card-body
                        if account.createdBy && account.createdBy.account_id
                            div.mb-2 <b>Người khởi tạo:</b> #{account.createdBy.account_id.fullname}
                            div.small.text-muted <b>Thời gian tạo:</b> #{moment(account.createdBy.createdAt).format('DD/MM/YYYY HH:mm:ss')}
                        else
                            p.text-muted.mb-0 Chưa có thông tin người khởi tạo.

                .card
                    .card-header.fw-bold Lịch sử cập nhật
                    .card-body
                        if account.updatedBy && account.updatedBy.length > 0
                            each item in account.updatedBy
                                if item.account_id
                                    .history-item.mb-3.pb-2.border-bottom.border-secondary
                                        .fw-bold.text-white #{item.account_id.fullname} <span class="fw-normal text-muted">đã cập nhật</span>
                                        .small.text-muted #{moment(item.updatedAt).format('DD/MM/YYYY HH:mm:ss')}
                        else
                            p.text-muted.mb-0 Chưa có lịch sử cập nhật nào.