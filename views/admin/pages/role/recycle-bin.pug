extends ../../layouts/default.pug
block main 
    .container-fluid
        .d-flex.align-items-center.justify-content-between.mb-4
            div
                h3.fw-bold.mb-1.text-white Thùng rác nhóm quyền
                p.text-muted.mb-0 Danh sách vai trò nhóm quyền đã bị xóa vào thùng rác
            a(href=`${prefixAdmin}/roles` class="btn btn-secondary")
                i.fa-solid.fa-arrow-left.me-2
                | Quay lại danh sách

        .card
            .card-header.d-flex.align-items-center.justify-content-between
                span.fw-bold
                    i.fa-solid.fa-trash-can.me-2.text-primary
                    | Danh sách nhóm quyền đã xóa (#{roles ? roles.length : 0})
            .card-body.p-0
                .table-responsive
                    table(class="table table-hover align-middle mb-0")
                        thead
                            tr.text-center
                                th(width="60px") STT
                                th.text-start Tên nhóm quyền
                                th.text-start Mô tả ngắn
                                th Người xóa
                                th Thời gian xóa
                                th(width="150px") Thao tác
                        tbody
                            if roles && roles.length > 0
                                each item, index in roles
                                    tr.text-center
                                        td.fw-bold #{index + 1}
                                        td.text-start.fw-bold #{item.title}
                                        td.text-start !{item.description ? item.description : '<span class="text-muted">Chưa có mô tả</span>'}
                                        td
                                            if item.deletedBy && item.deletedBy.account_id
                                                div.fw-bold.small #{item.deletedBy.account_id.fullname}
                                            else
                                                span.text-muted --
                                        td.small.text-muted #{item.deletedBy ? moment(item.deletedBy.deletedAt).format('DD/MM/YYYY HH:mm') : '--'}
                                        td
                                            .d-flex.justify-content-center.gap-1
                                                button(class="btn btn-success btn-sm" button-restore data-id=item.id title="Khôi phục")
                                                    i.fa-solid.fa-rotate-left.me-1
                                                    | Khôi phục
                                                button(class="btn btn-danger btn-sm" button-hard-delete data-id=item.id title="Xóa vĩnh viễn")
                                                    i.fa-solid.fa-trash-can
                            else 
                                tr 
                                    td(colspan="6" class="text-center text-muted py-4") Thùng rác trống

    form(action="" method="POST" form-hard-delete data-path=`${prefixAdmin}/roles/recycle-bin/hard-delete`)
    form(action="" method="POST" form-restore data-path=`${prefixAdmin}/roles/recycle-bin/restore`)
    script(src="/admin/js/recycleBin.js")