extends ../../layouts/default.pug
include ../../mixins/show-alert.pug

block main
    if(role.permissions.includes('role_view'))
        +alert-success(5000)
        .container-fluid
            .d-flex.align-items-center.justify-content-between.mb-4
                div
                    h3.fw-bold.mb-1.text-white Quản lý nhóm quyền
                    p.text-muted.mb-0 Danh sách vai trò và phân quyền quản trị trong hệ thống
                .d-flex.gap-2
                    if(role.permissions.includes('role_create'))
                        a(href=`${prefixAdmin}/roles/create` class="btn btn-primary")
                            i.fa-solid.fa-plus.me-2
                            | Thêm mới nhóm quyền
                    if(role.permissions.includes("permission"))
                        a(href=`${prefixAdmin}/roles/permissions` class="btn btn-warning") 
                            i.fa-solid.fa-key.me-2
                            | Phân quyền

            // Data Table Card
            .card
                .card-header.d-flex.align-items-center.justify-content-between
                    span.fw-bold
                        i.fa-solid.fa-user-shield.me-2.text-primary
                        | Danh sách nhóm quyền (#{roles ? roles.length : 0})
                .card-body.p-0
                    .table-responsive
                        table(class="table table-hover align-middle mb-0")
                            thead
                                tr.text-center
                                    th(width="60px") STT
                                    th.text-start Tiêu đề nhóm quyền
                                    th.text-start Mô tả ngắn
                                    th Người tạo
                                    th Người sửa
                                    th(width="140px") Hành động
                            tbody
                                if roles && roles.length > 0
                                    each item, index in roles 
                                        tr.text-center
                                            td.fw-bold #{index + 1}
                                            td.text-start.fw-bold #{item.title}
                                            td.text-start !{item.description ? item.description : '<span class="text-muted">Chưa có mô tả</span>'}
                                            td
                                                if(item.createdBy && item.createdBy.account_id)
                                                    div.fw-bold.small #{item.createdBy.account_id.fullname}
                                                    div.small.text-muted #{moment(item.createdBy.createdAt).format('DD/MM/YYYY HH:mm')}
                                                else
                                                    span.text-muted --
                                            td
                                                if(item.updatedBy && item.updatedBy.length > 0 && item.updatedBy[item.updatedBy.length - 1].account_id)
                                                    div.fw-bold.small #{item.updatedBy[item.updatedBy.length - 1].account_id.fullname}
                                                    div.small.text-muted #{moment(item.updatedBy[item.updatedBy.length - 1].updatedAt).format('DD/MM/YYYY HH:mm')}
                                                else
                                                    span.text-muted Chưa có
                                            td
                                                .d-flex.justify-content-center.gap-1
                                                    a(href=`${prefixAdmin}/roles/details/${item._id}` class="btn btn-info btn-sm" title="Xem chi tiết")
                                                        i.fa-solid.fa-eye
                                                    if(role.permissions.includes('role_edit'))
                                                        a(href=`${prefixAdmin}/roles/edit/${item._id}` class="btn btn-warning btn-sm" title="Chỉnh sửa")
                                                            i.fa-solid.fa-pen-to-square
                                                    if(role.permissions.includes('role_delete'))
                                                        button(class="btn btn-danger btn-sm" button-delete data-id=item._id title="Xóa")
                                                            i.fa-solid.fa-trash-can
                                else
                                    tr
                                        td(colspan="6" class="text-center text-muted py-4") Chưa có nhóm quyền nào

            form(
                action=""
                method="POST"
                form-delete
                data-path=`${prefixAdmin}/roles/delete`
            )