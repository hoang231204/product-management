extends ../../layouts/default.pug
block main
    .container-fluid
        // Header Greeting
        .d-flex.align-items-center.justify-content-between.mb-4
            div
                h3.fw-bold.mb-1.text-white Tổng quan trang quản trị
                p.text-muted.mb-0 Xin chào <b>#{user.fullname}</b>, đây là thống kê tình hình kinh doanh của hệ thống.
            //- span.badge.badge-primary.px-3.py-2 #{role.title}

        // Account Profile Bar
        .card.mb-4
            .card-body
                .d-flex.align-items-center.gap-4.flex-wrap
                    img(
                        src=(user.avatar ? user.avatar : "/admin/images/avatar-default.png")
                        class="rounded-circle object-fit-cover border border-secondary"
                        width="80"
                        height="80"
                        alt=user.fullname
                    )
                    div
                        h4.fw-bold.text-white.mb-1 #{user.fullname}
                        p.text-muted.mb-1
                            i.fa-solid.fa-envelope.me-2
                            | #{user.email}
                        p.text-muted.mb-0
                            i.fa-solid.fa-phone.me-2
                            | #{user.phone ? user.phone : 'Chưa cập nhật SĐT'}

        // Primary Metric Stat Cards
        .row.g-3.mb-4
            .col-xl-3.col-md-6
                .card.stat-card.h-100.border-left-primary
                    .card-body
                        .d-flex.align-items-center.justify-content-between
                            div
                                .small.text-uppercase.fw-bold.text-muted Tổng đơn hàng
                                .h3.fw-bold.text-white.mb-0.mt-2 #{totalOrders}
                            .p-3.rounded-circle.bg-primary.bg-opacity-10
                                //- i.fa-solid.fa-cart-shopping.fa-2x.text-primary
            .col-xl-3.col-md-6
                .card.stat-card.h-100.border-left-success
                    .card-body
                        .d-flex.align-items-center.justify-content-between
                            div
                                .small.text-uppercase.fw-bold.text-muted Đơn hàng trong ngày
                                .h3.fw-bold.text-success.mb-0.mt-2 #{ordersToday}
                            .p-3.rounded-circle.bg-success.bg-opacity-10
                                i.fa-solid.fa-calendar-day.fa-2x.text-success
            .col-xl-3.col-md-6
                .card.stat-card.h-100.border-left-info
                    .card-body
                        .d-flex.align-items-center.justify-content-between
                            div
                                .small.text-uppercase.fw-bold.text-muted Đơn hàng tháng này
                                .h3.fw-bold.text-info.mb-0.mt-2 #{ordersMonth}
                            .p-3.rounded-circle.bg-info.bg-opacity-10
                                i.fa-solid.fa-calendar-days.fa-2x.text-info
            .col-xl-3.col-md-6
                .card.stat-card.h-100.border-left-warning
                    .card-body
                        .d-flex.align-items-center.justify-content-between
                            div
                                .small.text-uppercase.fw-bold.text-muted Đơn chờ xử lý
                                .h3.fw-bold.text-warning.mb-0.mt-2 #{pendingOrders}
                            .p-3.rounded-circle.bg-warning.bg-opacity-10
                                i.fa-solid.fa-clock-rotate-left.fa-2x.text-warning

        // Revenue Breakdown Cards
        .row.g-3.mb-4
            .col-md-4
                .card.h-100
                    .card-body
                        .small.text-muted.fw-bold.mb-1 Doanh thu trong ngày
                        .h3.fw-bold.text-success #{todayRevenue.toLocaleString()} VNĐ
            .col-md-4
                .card.h-100
                    .card-body
                        .small.text-muted.fw-bold.mb-1 Doanh thu trong tháng
                        .h3.fw-bold.text-primary #{monthRevenue.toLocaleString()} VNĐ
            .col-md-4
                .card.h-100
                    .card-body.d-flex.align-items-center.justify-content-between
                        div
                            .small.text-muted.fw-bold.mb-1 Doanh thu năm #{selectedYear}
                            .h3.fw-bold.text-info #{yearRevenue.toLocaleString()} VNĐ
                        div
                            select(id="yearSelect" class="form-select form-control" onchange="changeYear(this.value)")
                                - var years = [2024, 2025, 2026]
                                each year in years
                                    option(value=year selected=(selectedYear == year)) Năm #{year}

        // Best Sellers & Category Summary Grid
        .row.g-4.mb-4
            .col-lg-6
                .card.h-100
                    .card-header.fw-bold
                        i.fa-solid.fa-trophy.me-2.text-warning
                        | Sản phẩm bán chạy nhất năm #{selectedYear}
                    .card-body.d-flex.align-items-center
                        if bestSeller && bestSeller.productInfo
                            .d-flex.align-items-center.gap-3
                                if bestSeller.productInfo.thumbnail
                                    img(src=bestSeller.productInfo.thumbnail class="rounded object-fit-cover" width="80" height="80")
                                div
                                    h5.fw-bold.text-white.mb-1 #{bestSeller.productInfo.title}
                                    p.mb-0.text-muted Đã bán được: <b class="text-success font-size-lg">#{bestSeller.totalSold}</b> sản phẩm
                        else
                            p.text-muted.mb-0 Chưa có dữ liệu bán hàng ghi nhận trong năm #{selectedYear}.

            .col-lg-6
                .card.h-100
                    .card-header.fw-bold
                        i.fa-solid.fa-chart-pie.me-2.text-primary
                        | Thống kê danh mục & Hệ thống
                    .card-body
                        .row.g-3.text-center
                            .col-4
                                .p-2.bg-dark.rounded
                                    .small.text-muted Danh mục
                                    .h4.fw-bold.text-white.mb-0 #{statistic.categoryProduct ? statistic.categoryProduct.total : 0}
                            .col-4
                                .p-2.bg-dark.rounded
                                    .small.text-muted Sản phẩm
                                    .h4.fw-bold.text-white.mb-0 #{statistic.product ? statistic.product.total : 0}
                            .col-4
                                .p-2.bg-dark.rounded
                                    .small.text-muted Quản trị viên
                                    .h4.fw-bold.text-white.mb-0 #{statistic.account ? statistic.account.total : 0}

        // Revenue Chart Canvas Card
        .card.mb-4
            .card-header.fw-bold
                i.fa-solid.fa-chart-line.me-2.text-info
                | Biểu đồ biến động doanh thu theo tháng năm #{selectedYear}
            .card-body
                div(style="height: 320px; position: relative;")
                    canvas(id="revenueChart")

    script(src="https://cdn.jsdelivr.net/npm/chart.js")
    script.
        function changeYear(year) {
            window.location.href = `/admin/dashboard?year=${year}`;
        }
        const revenueData = !{JSON.stringify(revenueChart)};
        const ctx = document.getElementById('revenueChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['T1', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7', 'T8', 'T9', 'T10', 'T11', 'T12'],
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: revenueData,
                    borderColor: '#6366f1',
                    backgroundColor: 'rgba(99, 102, 241, 0.1)',
                    fill: true,
                    tension: 0.35,
                    borderWidth: 3,
                    pointBackgroundColor: '#06b6d4',
                    pointRadius: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { labels: { color: '#f8fafc' } }
                },
                scales: {
                    x: { ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255,255,255,0.05)' } },
                    y: { ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255,255,255,0.05)' } }
                }
            }
        });