extends ../../layouts/default.pug
include ../../mixins/show-alert.pug

block main
    +alert-error(5000)
    +alert-success(5000)

    if(role.permissions.includes('order_view'))
        .container-fluid
            .d-flex.align-items-center.justify-content-between.mb-4
                div
                    h3.fw-bold.mb-1.text-white Chi tiết đơn hàng ##{order.order_code ? order.order_code : order._id}
                    p.text-muted.mb-0 Xem đầy đủ sản phẩm, thông tin giao hàng và lịch sử đơn
                a(href=`${prefixAdmin}/orders` class="btn btn-secondary")
                    i.fa-solid.fa-arrow-left.me-2
                    | Quay lại danh sách đơn hàng

            .row.g-4.mb-4
                // Status Box
                .col-md-6
                    .card.h-100
                        .card-header.fw-bold
                            i.fa-solid.fa-circle-info.me-2.text-primary
                            | Trạng thái đơn hàng
                        .card-body
                            .mb-3
                                case order.status
                                    when 'pending'
                                        span.badge.badge-warning.px-3.py-2 Đang chờ xử lý
                                    when 'confirmed'
                                        span.badge.badge-info.px-3.py-2 Đã xác nhận
                                    when 'shipped'
                                    when 'shipping'
                                        span.badge.badge-secondary.px-3.py-2 Đang giao hàng
                                    when 'delivered'
                                        span.badge.badge-success.px-3.py-2 Đã giao thành công
                                    default
                                        span.badge.badge-danger.px-3.py-2 Đã hủy đơn
                            div <b>Thời gian đặt hàng:</b> <span class="text-muted ms-2">#{moment(order.createdAt).format('DD/MM/YYYY HH:mm:ss')}</span>

                // Update History Box
                .col-md-6
                    .card.h-100
                        .card-header.fw-bold
                            i.fa-solid.fa-clock-rotate-left.me-2.text-primary
                            | Lịch sử cập nhật
                        .card-body
                            if order.updatedBy && order.updatedBy.length > 0
                                each item in order.updatedBy
                                    if item.account_id
                                        .history-item.mb-2.pb-2.border-bottom.border-secondary
                                            .fw-bold.text-white #{item.account_id.fullname} <span class="fw-normal text-muted">đã cập nhật</span>
                                            .small.text-muted #{moment(item.updatedAt).format('DD/MM/YYYY HH:mm:ss')}
                            else
                                p.text-muted.mb-0 Chưa có lịch sử cập nhật nào.

            // Customer Details Card
            .card.mb-4
                .card-header.fw-bold
                    i.fa-solid.fa-user.me-2.text-primary
                    | Thông tin người nhận
                .card-body
                    .row.g-3
                        .col-md-4
                            div.text-muted.small.mb-1 Họ tên người nhận:
                            div.fw-bold.text-white #{order.userInfor ? order.userInfor.fullname : '--'}
                        .col-md-4
                            div.text-muted.small.mb-1 Số điện thoại:
                            div.fw-bold.text-white #{order.userInfor ? order.userInfor.phone : '--'}
                        .col-md-4
                            div.text-muted.small.mb-1 Địa chỉ giao hàng:
                            div.fw-bold.text-white #{order.userInfor ? order.userInfor.address : '--'}

            // Products Table Card
            .card
                .card-header.fw-bold
                    i.fa-solid.fa-box-archive.me-2.text-primary
                    | Danh sách sản phẩm trong đơn hàng
                .card-body.p-0
                    if order && order.products && order.products.length > 0
                        .table-responsive
                            table(class="table table-hover align-middle text-center mb-0")
                                thead
                                    tr
                                        th(width="50px") STT
                                        th(width="80px") Hình ảnh
                                        th.text-start Tên sản phẩm
                                        th Đơn giá
                                        th Số lượng
                                        th Thành tiền
                                tbody
                                    each item, index in order.products
                                        tr
                                            td.fw-bold #{index + 1}
                                            td
                                                if item.product_id
                                                    img(src=item.product_id.thumbnail, alt=item.product_id.title, width="50", height="50", class="rounded object-fit-cover")
                                                else
                                                    span.text-muted --
                                            td.text-start
                                                if item.product_id
                                                    b.text-white #{item.product_id.title}
                                                else
                                                    span.text-danger Sản phẩm không còn tồn tại
                                            td #{item.priceNew ? item.priceNew.toLocaleString('vi-VN') : 0}$
                                            td.fw-bold #{item.quantity}
                                            td.text-success.fw-bold #{((item.priceNew || 0) * item.quantity).toLocaleString('vi-VN')}$

                        .d-flex.justify-content-end.align-items-center.p-3.border-top.border-secondary
                            .h4.fw-bold.mb-0.text-white
                                span.text-muted.fs-6.me-2 Tổng cộng giá trị đơn hàng:
                                span.text-success #{order.totalPrice ? order.totalPrice.toLocaleString('vi-VN') : 0}$
                    else
                        p.text-center.text-muted.py-4 Không có sản phẩm nào trong đơn hàng.