extends ../../layouts/default.pug
include ../../mixins/show-alert.pug
include ../../mixins/filter-status.pug
include ../../mixins/search.pug
include ../../mixins/change-multi.pug
include ../../mixins/sort.pug
include ../../mixins/pagination.pug

block main
    if(role.permissions.includes("order_view"))
        +alert-success(3000)
        +alert-error(3000)
        .container-fluid
            .d-flex.align-items-center.justify-content-between.mb-4
                div
                    h3.fw-bold.mb-1.text-white Quản lý đơn hàng
                    p.text-muted.mb-0 Theo dõi danh sách đơn đặt hàng, trạng thái xử lý và giao hàng

            // Single Consolidated Control Toolbar Card
            .card.mb-4
                .card-header.d-flex.align-items-center.justify-content-between
                    span.fw-bold
                        i.fa-solid.fa-sliders.me-2.text-primary
                        | Bộ lọc & Thao tác
                .card-body
                    .row.g-3.align-items-end.mb-3
                        .col-lg-5
                            label.form-label.small.text-muted.fw-bold Trạng thái
                            +boxFilter(filterStatus)
                        .col-lg-4
                            label.form-label.small.text-muted.fw-bold Tìm kiếm đơn hàng
                            +boxSearch(keyword)
                        .col-lg-3
                            label.form-label.small.text-muted.fw-bold Sắp xếp
                            +boxSort('order')
                    
                    if(role.permissions.includes("order_edit"))
                        hr.my-3.border-secondary.opacity-25
                        .row.align-items-center
                            .col-12
                                +boxChange(`${prefixAdmin}/orders/change-multi?_method=PATCH`, 'order')

            // Data Table Card
            .card
                .card-header.d-flex.align-items-center.justify-content-between
                    span.fw-bold
                        i.fa-solid.fa-cart-shopping.me-2.text-primary
                        | Danh sách đơn hàng (#{orders ? orders.length : 0})
                .card-body.p-0
                    .table-responsive
                        table(class="table table-hover align-middle mb-0" check-box-multi)
                            thead
                                tr.text-center
                                    th(width="40px")
                                        input(type="checkbox" name="checkAll" class="form-check-input")
                                    th(width="50px") STT
                                    th Mã đơn hàng
                                    th Khách hàng
                                    th SĐT
                                    th Địa chỉ
                                    th Tổng tiền
                                    th Thời gian đặt
                                    th Người cập nhật
                                    th Trạng thái
                                    th Thanh toán
                                    th(width="120px") Hành động
                            tbody
                                if orders && orders.length > 0
                                    each item, index in orders
                                        tr.text-center
                                            td 
                                                input(type="checkbox" name="id" value=item._id class="form-check-input")
                                            td.fw-bold #{index + 1}
                                            td.fw-bold.text-info #{item.order_code}
                                            td.fw-bold #{item.userInfor ? item.userInfor.fullname : '--'}
                                            td #{item.userInfor ? item.userInfor.phone : '--'}
                                            td.text-start.small #{item.userInfor ? item.userInfor.address : '--'}
                                            td.text-success.fw-bold #{item.totalPrice ? item.totalPrice.toLocaleString('vi-VN') : 0}$
                                            td.small.text-muted #{moment(item.createdAt).format('DD/MM/YYYY HH:mm')}
                                            td
                                                if item.updatedBy && item.updatedBy.length > 0 && item.updatedBy[item.updatedBy.length - 1].account_id
                                                    div.fw-bold.small #{item.updatedBy[item.updatedBy.length - 1].account_id.fullname}
                                                    div.small.text-muted #{moment(item.updatedBy[item.updatedBy.length - 1].updatedAt).format('DD/MM/YYYY HH:mm')}
                                                else
                                                    span.text-muted Chưa có
                                            td
                                                if(role.permissions.includes("order_edit"))
                                                    if item.status == 'pending'
                                                        a(href="javascript:;" class="badge badge-warning" button-change-status data-id=item._id data-status=item.status data-next-status="confirmed") Chờ xử lý
                                                    else if item.status == 'confirmed'
                                                        a(href="javascript:;" class="badge badge-info" button-change-status data-id=item._id data-status=item.status data-next-status="shipping") Đã xác nhận
                                                    else if item.status == 'shipping'
                                                        a(href="javascript:;" class="badge badge-secondary" button-change-status data-id=item._id data-status=item.status data-next-status="delivered") Đang giao
                                                    else if item.status == 'delivered'
                                                        a(href="javascript:;" class="badge badge-success" button-change-status data-id=item._id data-status=item.status) Đã giao
                                                    else 
                                                        a(href="javascript:;" class="badge badge-danger" button-change-status data-id=item._id data-status=item.status) Đã hủy
                                                else
                                                    span.badge.badge-primary #{item.status}
                                            td
                                                if item.payment_status == 'paid'
                                                    span.badge.badge-success Đã thanh toán
                                                else if item.payment_status == 'unpaid'
                                                    span.badge.badge-danger Chưa thanh toán
                                                else if item.payment_status == 'expired'
                                                    span.badge.badge-warning Hết hạn
                                                else if item.payment_status == 'cancelled'
                                                    span.badge.badge-secondary Đã hủy
                                                else
                                                    span.badge.badge-info Chưa xác định

                                            td
                                                .d-flex.justify-content-center.gap-1
                                                    a(href=`${prefixAdmin}/orders/details/${item._id}` class="btn btn-info btn-sm" title="Xem chi tiết")
                                                        i.fa-solid.fa-eye
                                                    if(role.permissions.includes("order_delete"))
                                                        button(type="button" class="btn btn-danger btn-sm" button-delete data-id=item._id title="Xóa")
                                                            i.fa-solid.fa-trash-can
                                else
                                    tr
                                        td(colspan="11" class="text-center text-muted py-4") Không có đơn hàng nào!  
                    .p-3
                        +pagination(objectPagination)

        form(action="" method="POST" form-change-status data-path=`${prefixAdmin}/orders/change-status`) 
        form(action="" method="POST" form-delete data-path=`${prefixAdmin}/orders/delete`)
        script(src="/admin/js/change-multi.js") 
    else
        .container-fluid.py-5.text-center
            i.fa-solid.fa-lock.fa-3x.text-danger.mb-3
            h3 Bạn không có quyền truy cập trang này!
