extends ../../layouts/default.pug
include ../../mixins/filter-status.pug
include ../../mixins/search.pug
include ../../mixins/pagination.pug
include ../../mixins/change-multi.pug
include ../../mixins/show-alert.pug
include ../../mixins/table-tree.pug

block main
    if(role.permissions.includes('product_category_view'))
        +alert-success(3000)
        +alert-error(3000)
        .container-fluid
            .d-flex.align-items-center.justify-content-between.mb-4
                div
                    h3.fw-bold.mb-1.text-white Quản lý danh mục sản phẩm
                    p.text-muted.mb-0 Quản lý cấu trúc cây danh mục và phân loại sản phẩm
                if(role.permissions.includes("product_category_create"))
                    a(href=`${prefixAdmin}/product-categories/create` class="btn btn-primary")
                        i.fa-solid.fa-plus.me-2
                        | Thêm mới danh mục

            // Single Consolidated Control Toolbar Card
            .card.mb-4
                .card-header.d-flex.align-items-center.justify-content-between
                    span.fw-bold
                        i.fa-solid.fa-sliders.me-2.text-primary
                        | Bộ lọc & Thao tác
                .card-body
                    .row.g-3.align-items-end.mb-3
                        .col-lg-6
                            label.form-label.small.text-muted.fw-bold Trạng thái
                            +boxFilter(filterStatus)
                        .col-lg-6
                            label.form-label.small.text-muted.fw-bold Tìm kiếm
                            +boxSearch(keyword)
                    
                    if(role.permissions.includes("product_category_edit"))
                        hr.my-3.border-secondary.opacity-25
                        .row.align-items-center
                            .col-12
                                +boxChange(`${prefixAdmin}/product-categories/change-multi?_method=PATCH`, 'category')

            // Tree Table Card
            .card
                .card-header.d-flex.align-items-center.justify-content-between
                    span.fw-bold
                        i.fa-solid.fa-layer-group.me-2.text-primary
                        | Danh sách danh mục
                .card-body.p-0
                    .table-responsive
                        table(class="table table-hover align-middle mb-0" check-box-multi)
                            thead
                                tr.text-center
                                    th(width="40px")
                                        input(type="checkbox" name="checkAll" class="form-check-input")
                                    th(width="60px") STT
                                    th(width="100px") Hình ảnh
                                    th.text-start Tiêu đề
                                    th(width="90px") Vị trí
                                    th Trạng thái
                                    th Người tạo
                                    th Người sửa
                                    th(width="140px") Hành động
                            tbody
                                if categoryTree && categoryTree.length > 0
                                    +table-tree(categoryTree, 1, "product_category")
                                else
                                    tr
                                        td(colspan="9" class="text-center text-muted py-4") Không có danh mục nào

        form(action="" method="POST" form-change-status data-path=`${prefixAdmin}/product-categories/change-status`)
        form(action="" method="POST" form-delete data-path=`${prefixAdmin}/product-categories/delete`)
        script(src="/admin/js/change-multi.js")