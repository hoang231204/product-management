extends ../../layouts/default.pug
include ../../mixins/show-alert.pug

block main
    +alert-error(5000)
    +alert-success(5000)

    .container-fluid
        .d-flex.align-items-center.justify-content-between.mb-4
            div
                h3.fw-bold.mb-1.text-white Chi tiết khách hàng
                p.text-muted.mb-0 Thông tin chi tiết tài khoản người dùng mua sắm
            .d-flex.gap-2
                if role.permissions.includes("user_edit")
                    a(href=`${prefixAdmin}/users/edit/${user._id}` class="btn btn-warning") 
                        i.fa-solid.fa-pen-to-square.me-1
                        | Chỉnh sửa
                a(href=`${prefixAdmin}/users` class="btn btn-secondary") 
                    i.fa-solid.fa-arrow-left.me-1
                    | Quay lại danh sách

        .row.g-4
            // Left Column: Avatar & Basic Info (4/12)
            .col-lg-4
                .card.text-center.p-4
                    img(
                        src=(user.avatar ? user.avatar : "/admin/images/avatar-default.png")
                        class="rounded-circle object-fit-cover border border-secondary mb-3 mx-auto"
                        width="140"
                        height="140"
                        alt=user.fullname
                    )
                    h4.fw-bold.text-white.mb-1 #{user.fullname}
                    span.badge(class=(user.status === 'active' ? 'badge-success' : 'badge-danger') + ' px-3 py-2 mb-3') #{user.status === 'active' ? "Hoạt động" : "Dừng hoạt động"}

                    .text-start.border-top.border-secondary.pt-3
                        div.mb-2 <b>Email:</b> #{user.email}
                        div.mb-2 <b>Số điện thoại:</b> #{user.phone || "Chưa cập nhật"}
                        div.mb-2 <b>Ngày đăng ký:</b> #{moment(user.createdAt).format('DD/MM/YYYY HH:mm:ss')}

            // Right Column: Update History (8/12)
            .col-lg-8
                .card
                    .card-header.fw-bold Lịch sử cập nhật hệ thống
                    .card-body
                        if user.updatedBy && user.updatedBy.length > 0
                            each item in user.updatedBy
                                if item.account_id
                                    .history-item.mb-3.pb-2.border-bottom.border-secondary
                                        .fw-bold.text-white #{item.account_id.fullname} <span class="fw-normal text-muted">đã cập nhật</span>
                                        .small.text-muted #{moment(item.updatedAt).format('DD/MM/YYYY HH:mm:ss')}
                        else
                            p.text-muted.mb-0 Chưa có thông tin cập nhật nào.