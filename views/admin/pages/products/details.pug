extends ../../layouts/default.pug
include ../../mixins/show-alert.pug

block main
    +alert-error(5000)
    +alert-success(5000)

    .container-fluid
        .d-flex.align-items-center.justify-content-between.mb-4
            div
                h3.fw-bold.mb-1.text-white Chi tiết sản phẩm
                p.text-muted.mb-0 Xem thông tin chi tiết và lịch sử cập nhật của sản phẩm
            .d-flex.gap-2
                if role.permissions.includes("product_edit")
                    a(href=`${prefixAdmin}/products/edit/${product._id}` class="btn btn-warning") 
                        i.fa-solid.fa-pen-to-square.me-1
                        | Chỉnh sửa
                a(href=`${prefixAdmin}/products` class="btn btn-secondary") 
                    i.fa-solid.fa-arrow-left.me-1
                    | Quay lại danh sách

        .row.g-4
            // Left Specs & Image (4/12)
            .col-lg-4
                .card.text-center.p-4
                    if product.thumbnail
                        img(src=product.thumbnail alt=product.title class="img-fluid rounded border border-secondary mb-3 object-fit-cover" style="max-height: 280px; width: 100%;")
                    else
                        .bg-dark.py-5.rounded.mb-3.text-muted Không có hình ảnh
                    
                    h4.fw-bold.text-white.mb-2 #{product.title}
                    h3.text-success.fw-bold.mb-3 #{product.price ? product.price.toLocaleString('vi-VN') : 0}VND
                    h4.text-danger.fw-bold.mb-3 -#{product.discountPercentage ? product.discountPercentage + "%" : 0 + "%"}
                    .text-start.border-top.border-secondary.pt-3
                        div.mb-2 <b>Danh mục:</b> #{product.category_id ? product.category_id.title : "Chưa chọn"}
                        div.mb-2 <b>Trạng thái:</b> 
                            if product.status === 'active'
                                span.badge.badge-success.ms-2 Hoạt động
                            else
                                span.badge.badge-danger.ms-2 Dừng hoạt động
                        div.mb-2 <b>Nổi bật:</b> 
                            if product.featured === '1'
                                span.badge.badge-primary.ms-2 Có
                            else
                                span.badge.badge-secondary.ms-2 Không
                        div.mb-2 <b>Số lượng kho:</b> <span class="fw-bold text-info">#{product.stock}</span>
                        div.mb-2 <b>Vị trí:</b> <span class="fw-bold">#{product.position}</span>

            // Right Description & History (8/12)
            .col-lg-8
                .card.mb-4
                    .card-header.fw-bold Mô tả chi tiết
                    .card-body
                        if product.description
                            .description-box !{product.description}
                        else
                            p.text-muted.mb-0 Chưa có mô tả cho sản phẩm này.

                .card
                    .card-header.fw-bold Lịch sử cập nhật
                    .card-body
                        if product.updatedBy && product.updatedBy.length > 0
                            each item in product.updatedBy
                                if item.account_id
                                    .history-item.mb-3.pb-2.border-bottom.border-secondary
                                        .fw-bold.text-white #{item.account_id.fullname} <span class="fw-normal text-muted">đã cập nhật</span>
                                        .small.text-muted #{moment(item.updatedAt).format('DD/MM/YYYY HH:mm:ss')}
                        else
                            p.text-muted.mb-0 Chưa có lịch sử cập nhật nào.