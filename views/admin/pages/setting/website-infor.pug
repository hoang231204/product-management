extends ../../layouts/default.pug
include ../../mixins/show-alert.pug

block main
    +alert-success(3000)
    +alert-error(3000)

    .card.mb-4
        .card-header Cài đặt thông tin website
        .card-body
            form(
                action=`${prefixAdmin}/settings/website-infor?_method=PATCH` 
                method="POST"
                enctype="multipart/form-data"
                form-upload
            )
                //- Tên Website
                .form-group.mb-3
                    label(for="websiteName") Tên website
                    input(
                        type="text" 
                        class="form-control" 
                        id="websiteName" 
                        name="websiteName" 
                        value=(setting && setting.websiteName ? setting.websiteName : "")
                        placeholder="Nhập tên website"
                    )

                //- Logo Website (Ảnh chính)
                .form-group.mb-3
                    div(class="form-group" upload-image)
                        label(for="logo") Logo
                        input(
                            type="file"
                            class="form-control-file"
                            id="logo"
                            name="logo"
                            accept="image/*"
                            upload-image-input
                        )
                        div(class="box-image")
                            img(
                                src=(setting && setting.logo ? setting.logo : "")
                                upload-image-preview
                                class="image-preview"
                            )
                            button(
                                type="button"
                                class="btn-remove-image"
                                aria-label="Remove image"
                            ) ×

                //- THÊM MỚI: Ô input upload ảnh phụ / Favicon hoặc Banner tùy chọn
                .form-group.mb-3
                    div(class="form-group" upload-image)
                        label(for="banner") Banner
                        input(
                            type="file"
                            class="form-control-file"
                            id="banner"
                            name="banner"
                            accept="image/*"
                            upload-image-input
                        )
                        div(class="box-image")
                            img(
                                src=(setting && setting.banner ? setting.banner : "")
                                upload-image-preview
                                class="image-preview"
                            )
                            button(
                                type="button"
                                class="btn-remove-image"
                                aria-label="Remove image"
                            ) ×

                //- Email
                .form-group.mb-3
                    label(for="email") Email
                    input(
                        type="email" 
                        class="form-control" 
                        id="email" 
                        name="email" 
                        value=(setting && setting.email ? setting.email : "")
                        placeholder="Nhập email"
                    )

                //- Số điện thoại
                .form-group.mb-3
                    label(for="phone") Số điện thoại
                    input(
                        type="text" 
                        class="form-control" 
                        id="phone" 
                        name="phone" 
                        value=(setting && setting.phone ? setting.phone : "")
                        placeholder="Nhập số điện thoại"
                    ) 

                //- Địa chỉ
                .form-group.mb-3
                    label(for="address") Địa chỉ
                    input(
                        type="text" 
                        class="form-control" 
                        id="address" 
                        name="address" 
                        value=(setting && setting.address ? setting.address : "")
                        placeholder="Nhập địa chỉ"
                    )

                //- THÊM MỚI: Vị trí trên bản đồ (Google Maps Iframe link hoặc Tọa độ Lat/Lng)
                .form-group.mb-3
                    label(for="mapLocation") Vị trí trên bản đồ (Link Google Maps nhúng hoặc Tọa độ)
                    input(
                        type="text" 
                        class="form-control" 
                        id="mapLocation" 
                        name="mapLocation" 
                        value=(setting && setting.mapLocation ? setting.mapLocation : "")
                        placeholder="Dán mã iframe Google Maps hoặc link nhúng bản đồ vào đây"
                    )
                    small.form-text.text-muted Bạn có thể nhập link chia sẻ nhúng bản đồ từ Google Maps để hiển thị ngoài trang chủ.

                //- Copyright
                .form-group.mb-3
                    label(for="copyright") Copyright
                    input(
                        type="text" 
                        class="form-control" 
                        id="copyright" 
                        name="copyright" 
                        value=(setting && setting.copyright ? setting.copyright : "")
                        placeholder="Nhập thông tin bản quyền"
                    )

                //- Mạng xã hội Card
                .card.mb-4
                    .card-header Mạng xã hội
                    .card-body
                        .row
                            .col-md-6
                                .form-group
                                    label(for="facebook") Facebook
                                    input.form-control(
                                        type="text" 
                                        id="facebook" 
                                        name="social.facebook" 
                                        value=(setting && setting.social && setting.social.facebook ? setting.social.facebook : "")
                                        placeholder="Link Facebook"
                                    )
                            .col-md-6
                                .form-group
                                    label(for="tiktok") TikTok
                                    input.form-control(
                                        type="text" 
                                        id="tiktok" 
                                        name="social.tiktok" 
                                        value=(setting && setting.social && setting.social.tiktok ? setting.social.tiktok : "")
                                        placeholder="Link TikTok"
                                    )
                            .col-md-6
                                .form-group
                                    label(for="youtube") YouTube
                                    input.form-control(
                                        type="text" 
                                        id="youtube" 
                                        name="social.youtube" 
                                        value=(setting && setting.social && setting.social.youtube ? setting.social.youtube : "")
                                        placeholder="Link YouTube"
                                    )

                button(type="submit" class="btn btn-primary") Cập nhật