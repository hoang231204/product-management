mixin boxSearch(keyword)
    form(id="form-search" class="w-100")
        .input-group
            input(
                type="text"
                placeholder="Nhập từ khóa tìm kiếm..."
                name="keyword"
                class="form-control"
                value=keyword
            )
            .input-group-append
                button(class="btn btn-primary" type="submit")
                    i.fa-solid.fa-magnifying-glass.me-1
                    | Tìm
