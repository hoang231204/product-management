mixin boxFilter(filterStatus)
    if filterStatus && filterStatus.length > 0
        .d-flex.flex-wrap.gap-2
            each item in filterStatus
                button(
                    class=`btn btn-sm ${item.class === 'active' ? 'btn-primary' : 'btn-outline-secondary'}`
                    button-status=item.status
                ) #{item.name}