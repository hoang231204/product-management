PORT=3000
# Cloud connection strings. Do not commit the real values.
MONGO=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
REDIS_URL=rediss://default:<password>@<host>:<port>
ACCESS_TOKEN_SECRET=local-only-change-this-secret
ACCESS_TOKEN_TTL=15m
NODE_ENV=development

# Optional: required only for uploads and email/password recovery.
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
SMTP_SERVICE=
SMTP_MAIL=
SMTP_PASS=

# Optional: required only for VNPay checkout testing.
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3001/checkout/vnpay_return
VNP_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction